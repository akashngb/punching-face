# OMNI Live (Qwen3.5-Omni) integration. Copy to .env; never commit real values.
# Precedence: process env > .env > .local/secrets/omni.json.

# Master switch. When false, both routes still run but no OMNI traffic is sent.
OMNI_ENABLED=true

# API credentials (Huawei form: https://luma.com/0fhypcu0). Yibuapi is the sponsored gateway.
OMNI_API_KEY=

# Endpoint. Confirm with scripts/omni_smoke_test.py which plan is available.
# - Plan A/B (Realtime WebSocket): OMNI_REALTIME_URL=wss://<gateway>/realtime  or the DashScope intl endpoint
# - Plan C (chat completions):     OMNI_BASE_URL=https://yibuapi.com/v1
OMNI_BASE_URL=https://yibuapi.com/v1
OMNI_REALTIME_URL=

# Models. Flash is the low-latency default; plus if quality matters more.
OMNI_MODEL=qwen3.5-omni-flash
OMNI_REALTIME_MODEL=qwen3.5-omni-plus-realtime
OMNI_VOICE=Ethan

# Voice cloning (Plan A only, when the gateway supports it). Leave blank on Plan C.
OMNI_CLONED_VOICE_ID=

# ElevenLabs (fallback voice + pre-generated cached reaction audio for Plan C).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Meshy cloud reconstruction: the second engine in the scan dialog (README "Reconstruction engines").
# Create the key at meshy.ai > Settings > API. Precedence: process env > .env > .local/secrets/meshy.json
# (the file the dialog's "Save key on server" writes). server.py reads this at start: restart npm run dev.
MESHY_API_KEY=
# Optional. Defaults: latest (Meshy 7.1), 30000 triangles, base colour only.
# MESHY_AI_MODEL=latest
# MESHY_TARGET_POLYCOUNT=30000
# MESHY_ENABLE_PBR=1
