{
  "name": "punching-face",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:reconstruction": "node scripts/py.mjs tests/reconstruction_test.py",
    "fixtures": "node scripts/py.mjs scripts/make_fixture.py",
    "sponsors": "node scripts/py.mjs sponsor_server.py",
    "livekit:dev": "livekit-server --dev --bind 127.0.0.1",
    "build:guest": "vite build --config vite.guest.config.js",
    "test:sponsors": "node scripts/py.mjs tests/sponsor_server_test.py && node scripts/py.mjs tests/sponsor_obs_test.py",
    "omni:smoke": "node scripts/py.mjs scripts/omni_smoke_test.py",
    "omni:report": "node scripts/py.mjs scripts/omni_usage_report.py",
    "omni:relay": "node scripts/py.mjs omni_relay.py"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "@sentry/browser": "^10.75.0",
    "@sparkjsdev/spark": "2.2.0",
    "@tensorflow-models/body-segmentation": "^1.0.2",
    "@tensorflow/tfjs": "^4.22.0",
    "livekit-client": "^2.22.3",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "vite": "8.3.0"
  }
}
