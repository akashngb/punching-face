{
  "name": "punching-face",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "npm run format:web && npm run format:python",
    "format:check": "npm run format:web:check && npm run format:python:check",
    "format:web": "prettier --write \"**/*.{js,mjs,css,html}\" package.json .prettierrc.json",
    "format:web:check": "prettier --check \"**/*.{js,mjs,css,html}\" package.json .prettierrc.json",
    "format:python": ".local/format-env/bin/python -m black .",
    "format:python:check": ".local/format-env/bin/python -m black --check .",
    "dev": "node scripts/dev.mjs",
    "dev:video": "node scripts/dev-video.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:reconstruction": ".venv/bin/python tests/reconstruction_test.py",
    "fixtures": ".venv/bin/python scripts/make_fixture.py",
    "sponsors": ".venv/bin/python sponsor_server.py",
    "livekit:dev": "livekit-server --dev --bind 127.0.0.1",
    "build:guest": "vite build --config vite.guest.config.js",
    "test:sponsors": ".venv/bin/python tests/sponsor_server_test.py && .venv/bin/python tests/sponsor_obs_test.py",
    "omni:smoke": ".venv/bin/python scripts/omni_smoke_test.py",
    "omni:report": ".venv/bin/python scripts/omni_usage_report.py",
    "omni:relay": ".venv/bin/python omni_relay.py"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "@sentry/browser": "^10.75.0",
    "@sparkjsdev/spark": "2.2.0",
    "@tensorflow-models/body-segmentation": "^1.0.2",
    "@tensorflow/tfjs": "^4.22.0",
    "livekit-client": "^2.22.3",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "vite": "8.3.0"
  }
}
