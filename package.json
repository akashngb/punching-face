{
  "name": "punching-face",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:reconstruction": ".venv/bin/python tests/reconstruction_test.py",
    "fixtures": ".venv/bin/python scripts/make_fixture.py",
    "sponsors": ".venv/bin/python sponsor_server.py",
    "livekit:dev": "livekit-server --dev --bind 127.0.0.1",
    "build:guest": "vite build --config vite.guest.config.js",
    "test:sponsors": ".venv/bin/python tests/sponsor_server_test.py && .venv/bin/python tests/sponsor_obs_test.py",
    "omni:smoke": ".venv/bin/python scripts/omni_smoke_test.py",
    "omni:report": ".venv/bin/python scripts/omni_usage_report.py",
    "omni:relay": ".venv/bin/python omni_relay.py"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "@sentry/browser": "^10.75.0",
    "@sparkjsdev/spark": "2.2.0",
    "@tensorflow-models/body-segmentation": "^1.0.2",
    "@tensorflow/tfjs": "^4.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "livekit-client": "^2.22.3",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "8.3.0"
  }
}
