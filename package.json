{
  "name": "punching-face",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "npm run format:web && npm run format:python",
    "format:check": "npm run format:web:check && npm run format:python:check",
    "format:web": "prettier --write \"**/*.{js,mjs,css,html}\" package.json .prettierrc.json",
    "format:web:check": "prettier --check \"**/*.{js,mjs,css,html}\" package.json .prettierrc.json",
    "format:python": ".local/format-env/bin/python -m black .",
    "format:python:check": ".local/format-env/bin/python -m black --check .",
    "dev": "node scripts/dev.mjs",
    "dev:video": "node scripts/dev-video.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:reconstruction": "node scripts/py.mjs tests/reconstruction_test.py",
    "fixtures": "node scripts/py.mjs scripts/make_fixture.py",
    "sponsors": "node scripts/py.mjs sponsor_server.py",
    "livekit:dev": "livekit-server --dev --bind 127.0.0.1",
    "build:guest": "vite build --config vite.guest.config.js",
    "test:sponsors": "node scripts/py.mjs tests/sponsor_server_test.py && node scripts/py.mjs tests/sponsor_obs_test.py",
    "omni:smoke": "node scripts/py.mjs scripts/omni_smoke_test.py",
    "omni:report": "node scripts/py.mjs scripts/omni_usage_report.py",
    "omni:relay": "node scripts/py.mjs omni_relay.py"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "@sentry/browser": "^10.75.0",
    "@sparkjsdev/spark": "2.2.0",
    "@tensorflow-models/body-segmentation": "^1.0.2",
    "@tensorflow/tfjs": "^4.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "livekit-client": "^2.22.3",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "3.9.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "8.3.0"
  }
}
